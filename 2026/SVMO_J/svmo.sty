% (Encapsulated PostScript).

\newcommand{\insertpicture}[3]{
\begin{figure}[!ht]
\vbox{
\begin{center}
\includegraphics[scale=#3]{#2}
\caption{ \\ \textbf{Fig \ref{#1}.}}
\label{#1}
\end{center}
}
